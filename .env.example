# LeadFlow environment template. Never commit real secrets.

# Supabase/Postgres connection string for the server-side Drizzle layer.
DATABASE_URL=postgresql://postgres.<PROJECT-REF>:<PASSWORD>@<POOLER-HOST>:6543/postgres?pgbouncer=true

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server/Edge secrets only. Never expose these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
EXTERNAL_LEAD_API_KEY=

NEXT_PUBLIC_APP_NAME="LeadFlow Outreach CRM"
DEFAULT_COUNTRY_CODE="+91"
